{
  "name": "cicd-starter",
  "version": "1.0.0",
  "private": true,
  "description": "最小可运行的 Node + TypeScript 项目模板，配套 GitHub Actions 自动构建与测试",
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "cicd-starter": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/test/*.test.js\"",
    "smoke": "node dist/src/cli.js 1 2 3",
    "ci": "npm run typecheck && npm run build && npm test && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
